        <Canvas Id="BP6BAUtrOPAWerk3rnkONJ" CanvasType="Group">
          <Pad Id="EnjGyg2wxJnvB5jmYzvUKh" Bounds="60,40,255,41" ShowValueBox="true" isIOBox="true" Value="Use ConvexHull!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="DKjuwOtWYzzlpLmZ1yEWEy" Bounds="60,95,480,64" ShowValueBox="true" isIOBox="true" Value="The smallest convex polygon around everything in a geometry - a rubber band. The usual way to get one outline around a spread of points.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CSo2Mz3gIUJQJ9RY8W28HE" Comment="Points" Bounds="60,170,460,15" ShowValueBox="true" isIOBox="true" Value="MULTIPOINT ((0 0), (4 0), (4 3), (1 1), (2 2), (0 3))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="PsUcOWpijzVzC0BHukHfUN" Bounds="580,170,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Six points: four corners and two inside. Paste any geometry here - a LineString, a polygon with a dent.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
