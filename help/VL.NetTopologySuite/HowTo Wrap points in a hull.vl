          <Pad Id="UEL1FKXFjkfYUr8IG4RVy4" Bounds="580,290,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Area 12: the band touches the four corners and the two inside points are gone. A Polygon, whatever went in; collinear points give a LineString, one point a Point.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
