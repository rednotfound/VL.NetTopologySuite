  <Patch Id="D25bdIyoK07cSTVwqoaTQp">
    <Canvas Id="JwThZlwSNYbJp364LtMWqH" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="Qm3Sf7lo1Upuxqd4Rz5Jks">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="ABDOmF3k99HjEZdbWvcjHB">
        <Canvas Id="RetGerIzRlf0yz2N1Q8Ntz" CanvasType="Group">
          <Pad Id="Mpu65VykMnCCTgWpTm4UyI" Bounds="60,40,435,41" ShowValueBox="true" isIOBox="true" Value="Use Read WKT and Write WKT!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="MK02ovM7HmscgtisGJgcVO" Bounds="60,95,480,64" ShowValueBox="true" isIOBox="true" Value="Well-Known Text is the plain-text form of a geometry, and the quickest way to get one into a patch. Edit the box and watch type, area and SRID follow.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="ASDbIXFhtvswMXzyFBYiNB" Comment="WKT" Bounds="60,170,400,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="UI17z6d0Txb1uJSslKzGD3" Bounds="580,170,380,116" ShowValueBox="true" isIOBox="true" Value="&lt; Try these:&#xD;&#xA;POINT (139.7671 35.6812)&#xD;&#xA;LINESTRING (0 0, 1 1, 2 0)&#xD;&#xA;POLYGON ((0 0, 1 0, 1 1, 0 1))   unclosed - closed for you&#xD;&#xA;SRID=4326;POINT (1 2)   the SRID travels along">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,220,90,19" Id="S1O4ZqkiIvSjywqBM67gEG">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="Fiinz0RHlCq8weecbA1tqA" Name="WKT" Kind="InputPin" />
            <Pin Id="LZl3AALpEhuHVrSRrziEQd" Name="Factory" Kind="InputPin" />
            <Pin Id="OtLTS3uW0rBOXs1FLcTHjZ" Name="Result" Kind="OutputPin" />
            <Pin Id="UjZJlBTulugYcH9BteJObQ" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="NL80N0MnpWmPwjcWE6EFrM" Comment="Success" Bounds="200,220,60,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="NVdCVybI2QV4hAZnZzPDz1" Bounds="580,294,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Break the text on purpose: Success goes False and the geometry goes empty. The node never throws - half-typed text is the normal state of a box being edited.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,350,110,19" Id="S439mJl7rOxtrDDL2zi4fn">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="GeometryType" />
            </p:NodeReference>
            <Pin Id="Kf6uppdwImeh8Nc0u6gJWD" Name="Geometry" Kind="InputPin" />
            <Pin Id="HmvAlEf8mNWBZ6k9YZMRm1" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="KtAmEhCdnRrjkvIsxZw7BH" Comment="Type" Bounds="60,390,120,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="230,350,50,19" Id="Vy0e3pink9Y6mturbOdR84">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Area" />
            </p:NodeReference>
            <Pin Id="RpHzWasr8wPNSaYzDOjm9y" Name="Geometry" Kind="InputPin" />
            <Pin Id="OSfCv4KDnKrM9qnPEW6WGD" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="A3pVx5JBdzpedmeHKSt2wf" Comment="Area" Bounds="230,390,80,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="360,350,50,19" Id="UaHL3c2s9TZMLRbxLsglJg">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="SRID" />
            </p:NodeReference>
            <Pin Id="StnOqJC2YDqVgtVlognq70" Name="Geometry" Kind="InputPin" />
            <Pin Id="FZVF2FtCkRMLAhIWw3hycV" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="DH5I8UB7n3eleF0sXxrBeJ" Comment="SRID" Bounds="360,390,60,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="ApYSB9FnxlZQfh920LV3NO" Bounds="580,382,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; SRID 0 means &quot;unset&quot;, the same as the creation nodes say. NetTopologySuite's own reader would say -1 here; this package corrects it so one number means &quot;nobody said&quot;.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,460,90,19" Id="EhKrbadRz1ToFh0iK1AEST">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="DVsgddW4wrHh6E5SLUXvhr" Name="Geometry" Kind="InputPin" />
            <Pin Id="CmZ5NsdRTqGNmHlwmFjMfm" Name="Include Z" Kind="InputPin" />
            <Pin Id="DStlaOgXy3NUkZk4ORPMxv" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="C3uE93dCHMzfOJjLbOvL26" Comment="WKT" Bounds="60,500,400,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="QK89otar8NKjVt2ZPbXe2E" Bounds="580,470,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Write WKT does NOT carry the SRID back out - plain WKT has nowhere to put it. Z is dropped too unless Include Z is on.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
