  <Patch Id="NemXZEANnUG0Gr4Wyx4Rex">
    <Canvas Id="JSmenteK4JcMXW6Mkj0kw4" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="RozZh0TyNL6CcHXEEhuxRR">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="Lsno7bzhT0giVWFlNSer4L">
        <Canvas Id="Gt7YrAJaybe1CrCjUmgIcj" CanvasType="Group">
          <Pad Id="E72ceoG8ZEQLcwfXV1HNy4" Bounds="60,60,900,190" ShowValueBox="true" isIOBox="true" Value="One idea: asking every geometry &quot;do you touch this?&quot; is fine for ten and hopeless for a hundred thousand. An index answers &quot;which ones MIGHT?&quot; in a handful of steps.&#xD;&#xA;&#xD;&#xA;SpatialIndex builds an STRtree over a Spread of geometries once, and rebuilds only when the set of geometries changes - Indexes Built shows that: edit the search area all you like and it stays at 1. Query asks the tree which geometries have a bounding box touching the search geometry's bounding box. Those are CANDIDATES, not answers: the boxes touched, the shapes may not have. The final yes/no is still Intersects on each candidate - but now on a few instead of on all.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EtFTzeROfp1ZC4tRcvFnSp" Comment="inside the search area" Bounds="60,290,300,15" ShowValueBox="true" isIOBox="true" Value="POINT (1 1)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="600,290,90,19" Id="H6lriALp9zasg8UWZXtlAZ">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
