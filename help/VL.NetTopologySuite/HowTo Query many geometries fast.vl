            <Pin Id="CouDzgjmgctw26Y8RPOa1V" Name="Result" Kind="OutputPin" />
            <Pin Id="JnYX6fwJf4gmKytdCbXgGd" Name="Count" Kind="OutputPin" />
            <Pin Id="D92rmUwuXuu2zD0apTB4OM" Name="Indexes Built" Kind="OutputPin" />
          </Node>
          <Pad Id="LXhmIXLbxnpMW7yx7a0S2E" Comment="geometries indexed" Bounds="240,480,60,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="DTkDakhuYTP1xDCQXFTEQZ" Comment="indexes built - stays at 1 while you edit the search" Bounds="480,480,60,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="GlrIP29mE1TOykO4hnV2BZ" Comment="search area - edit me" Bounds="60,550,460,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0.5 0.5, 1.5 0.5, 1.5 1.5, 0.5 1.5, 0.5 0.5))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,590,90,19" Id="K23BONLiTGa14tTWzCtotB">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="UPnzvgKZfLh2DzAKEFTAQN" Name="WKT" Kind="InputPin" />
            <Pin Id="KmM6gwns2GYIZstPvvdcyl" Name="Factory" Kind="InputPin" />
            <Pin Id="AfS90JuRwUNj76Vu8F1d6o" Name="Result" Kind="OutputPin" />
            <Pin Id="AUvD4SFkOtbuANs8VufpZK" Name="Success" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,650,60,19" Id="OiJX9B3MZIjoUpMid1ZUug">
            <p:NodeReference LastCategoryFullName="NTS.Index" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Query" />
            </p:NodeReference>
            <Pin Id="P2bT4qhEvtXcKETNKt1x35" Name="Index" Kind="InputPin" />
            <Pin Id="CM9xjWHP3BfN7hqdVnnxLw" Name="Search Geometry" Kind="InputPin" />
            <Pin Id="T7KDHV8Uu32DImLRrzd6xH" Name="Result" Kind="OutputPin" />
            <Pin Id="NMHDnp6TBMPbY0DybS2BXR" Name="Candidate Count" Kind="OutputPin" />
          </Node>
          <Pad Id="PZ0ZHGJWce0VLZAuSuYVsF" Comment="candidates (2: point + line)" Bounds="240,650,60,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="UIS0ftBBvn1bvRbsnWOZEr" Comment="the candidates (a Spread)" Bounds="60,690,300,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="600,650,80,19" Id="Okrmxk7FZvjv7QppJGDA5c">
            <p:NodeReference LastCategoryFullName="NTS.Operation" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Intersects" />
            </p:NodeReference>
            <Pin Id="I6iogBDrJ6YtB1PNASDFVB" Name="A" Kind="InputPin" />
            <Pin Id="DTITsNr5ehWTzMCKR9x6l1" Name="B" Kind="InputPin" />
            <Pin Id="TiYq6IxTr23kEMkK11i94q" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="OQBIrfQlyfoeKzb8gXa5tz" Comment="does the search really touch the line? No" Bounds="600,690,60,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="SLOYVNlWouGcRsJVTDNj6i" Bounds="60,750,900,240" ShowValueBox="true" isIOBox="true" Value="What the index promises: no false negatives. Everything that truly intersects is among the candidates; some candidates do not, and the line here is one - its bounding box covers the whole search area while the line itself passes wide of it. So Query is the first half of the question and Intersects is the second, run only on the candidates. On 100,000 points that is the difference between 8 frames a second and a smooth patch.&#xD;&#xA;&#xD;&#xA;Why a process node: an index over 100,000 geometries is not something to build sixty times a second. SpatialIndex rebuilds when the set of geometry REFERENCES changes - a different count, or a different object in any slot - never because the Spread wrapper is new or the search moved. Mutating an indexed geometry in place is undetectable, and unreachable through this package's own nodes, which copy on the way in.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
