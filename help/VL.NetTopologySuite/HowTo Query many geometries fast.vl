          <Pad Id="FSBh9yN7xrZG8odZkHFLpj" Comment="near, not touching" Bounds="60,370,300,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((2 2, 3 2, 3 3, 2 3, 2 2))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="600,370,90,19" Id="SlAbxmTDFmTIalhhJqkUp5">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="Umkqhcys0QVaJKAq225lRU" Name="WKT" Kind="InputPin" />
            <Pin Id="Fzu2rDeHG3ljfTXwf2dIpD" Name="Factory" Kind="InputPin" />
            <Pin Id="RdP5TGnuxXnacTKMH5oqs6" Name="Result" Kind="OutputPin" />
            <Pin Id="GoK8CpBzUJjcZaF3ZnOCbx" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="EtWf1rboz6GSDh6f3LEmKk" Comment="misses the area; its BOX covers it" Bounds="60,410,300,15" ShowValueBox="true" isIOBox="true" Value="LINESTRING (0 4, 4 0)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="600,410,90,19" Id="CgqHFVgxQhbtolRac8hTAL">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="ME4VnOF27PL8WlKLb2XXi8" Name="WKT" Kind="InputPin" />
