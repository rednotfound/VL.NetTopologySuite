            <Pin Id="QYvWBoE8xSWffW4rGb7ri4" Name="Result" Kind="OutputPin" />
            <Pin Id="BfQ1T8KF7XNnXartDCVROU" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="NHHua8dRGyvt6QKZAhGt8W" Comment="far away" Bounds="60,330,300,15" ShowValueBox="true" isIOBox="true" Value="POINT (5 5)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
