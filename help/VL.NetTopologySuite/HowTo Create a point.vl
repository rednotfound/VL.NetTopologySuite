  <Patch Id="KG5qJq3WjKKSWaJJTiclbn">
    <Canvas Id="FbeKQ1jVWR8kGU6gfsywJ3" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="M8GeWnsOwQNJ3sOAzA4wX9">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="NdBH8ENvtwGXtKOlDSRVPK">
        <Canvas Id="GST7YRTWETpOKayTKm3aHr" CanvasType="Group">
          <Pad Id="Ta6dTS6lfNRHBOsWLEkVRY" Bounds="60,40,405,41" ShowValueBox="true" isIOBox="true" Value="Use Coordinate and Point!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EXfyeoM3jQEEUz7cqqd0op" Bounds="60,95,480,46" ShowValueBox="true" isIOBox="true" Value="Two numbers become a Coordinate, the Coordinate becomes a Point, and Write WKT shows what you made. X first, then Y.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="CG4URh17RsZYNZKvbAWGrh" Comment="X" Bounds="60,170,100,15" ShowValueBox="true" isIOBox="true" Value="139.7671">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="EiKDUkSIInSJEJu8pIpT8j" Comment="Y" Bounds="60,210,100,15" ShowValueBox="true" isIOBox="true" Value="35.6812">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="RBFEKjz1ajoTUW5RSsSsbM" Bounds="580,170,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; X then Y. For geographic data that is longitude, then latitude - the opposite of how they are usually spoken, and the most common mistake in this domain.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,260,80,19" Id="JibND0k8r1hJrNgu6d3Pqd">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Coordinate" />
            </p:NodeReference>
            <p:HelpFocus p:Assembly="VL.Lang" p:Type="VL.Model.HelpPriority">High</p:HelpFocus>
            <Pin Id="Ud6mdAzz8bSbQDnDVPordR" Name="X" Kind="InputPin" />
            <Pin Id="Id9LW8sbwyu5X2kwX78qIK" Name="Y" Kind="InputPin" />
            <Pin Id="HBHhY1VqGikCdHkhmMyTIk" Name="Result" Kind="OutputPin" />
