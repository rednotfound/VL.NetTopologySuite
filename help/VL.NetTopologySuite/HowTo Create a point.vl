  <Patch Id="RaVNd7EGvsNNJilGmoh9u4">
    <Canvas Id="Tc8ZVC2hQM2HcmQqTcSMrQ" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="RPc8jkqCqFZb53jfIMoWAt">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="TjbbxUZu3w0TNhomyIgEmE">
        <Canvas Id="N1AXUBkL8x0sX1TcRJtjIN" CanvasType="Group">
          <Pad Id="GAcDHuJkzSmscuygwLsJh5" Bounds="60,40,405,41" ShowValueBox="true" isIOBox="true" Value="Use Coordinate and Point!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="RGDugmNA3K49fidEoxkcEq" Bounds="60,95,480,46" ShowValueBox="true" isIOBox="true" Value="Two numbers become a Coordinate, the Coordinate becomes a Point, and Write WKT shows what you made. X first, then Y.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Kao9a7kTWD37lLrrzkdta1" Comment="X" Bounds="60,170,100,15" ShowValueBox="true" isIOBox="true" Value="139.7671">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="AJcnZmDGNTnC6bicFp2s5T" Comment="Y" Bounds="60,210,100,15" ShowValueBox="true" isIOBox="true" Value="35.6812">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="VtrAAOrqJvQoXLPr064GfO" Bounds="580,170,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; X then Y. For geographic data that is longitude, then latitude - the opposite of how they are usually spoken, and the most common mistake in this domain.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,260,80,19" Id="LF0m202J5SSiXUzMUD2LKZ">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Coordinate" />
            </p:NodeReference>
            <Pin Id="NcFQ4AinLoTTOtex1yLD1W" Name="X" Kind="InputPin" />
            <Pin Id="R1edom5Om1dYuyTvxxXyYp" Name="Y" Kind="InputPin" />
            <Pin Id="SyNfLrc51nO6n6wu3FP9aD" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,320,60,19" Id="QbLmnWyBxQvTtKJc0DCbTy">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Point" />
            </p:NodeReference>
            <Pin Id="ITvnntBXyIEzQB4ewknYW3" Name="Coordinate" Kind="InputPin" />
            <Pin Id="NBntG5itxGva0529YNNP6r" Name="Factory" Kind="InputPin" />
            <Pin Id="FZP5Q6lIYhcjPn9Z60kMAY" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="HgSIJzimr7azBC73Y8Y3xU" Bounds="580,320,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Factory left unconnected: SRID 0, meaning &quot;unset&quot;. Connect a GeometryFactory node to say 4326. An SRID is a label - it never moves a coordinate.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,380,90,19" Id="BHeburbJD8pXvIKDheBOyd">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="GbEl7qfcuVUMq40LeonM72" Name="Geometry" Kind="InputPin" />
            <Pin Id="PXLUIa8a05FuPsDb5w6pNY" Name="Include Z" Kind="InputPin" />
            <Pin Id="Jt97Num33K39JooNMo3mjh" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="GGEESDZSidouiFK8E71AqN" Comment="WKT" Bounds="60,420,300,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="MnW2FVovoEKOXP524aiumn" Bounds="580,408,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Well-Known Text: the same text pastes into any other GIS tool. See HowTo Read and write WKT.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
