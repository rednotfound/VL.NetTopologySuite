            <Pin Id="EYnEdjW3t8ZG4PafgxBG6r" Name="Coordinate" Kind="InputPin" />
            <Pin Id="BcaOzGsyG2ye3ewSPZfLUM" Name="Factory" Kind="InputPin" />
            <Pin Id="UiQI9faYoR2Ij2GiIJMMjI" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="TuF85o4jdL9B7D8LGmtCYr" Bounds="580,320,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Factory left unconnected: SRID 0, meaning &quot;unset&quot;. Connect a GeometryFactory node to say 4326. An SRID is a label - it never moves a coordinate.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,380,90,19" Id="IJn2MiZJrAtm8YQh3zxOep">
