          <Pad Id="MdCaZrrdtxLtBHm34nGerP" Bounds="580,408,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Well-Known Text: the same text pastes into any other GIS tool. See HowTo Read and write WKT.">
            <p:TypeAnnotation>
