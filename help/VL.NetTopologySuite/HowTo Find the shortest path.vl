          </Pad>
          <Pad Id="VZqYOtYhE4aEvm2ZUGVYCC" Bounds="60,95,480,82" ShowValueBox="true" isIOBox="true" Value="Close does not mean reachable. A small town: two banks of streets, one bridge between them, a curved street, two dead ends, and an island that touches nothing. The Renderer draws the streets grey, the shortest path teal, From and To as dots.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="RiA1yvcmb3cTKbvPRERtG5" Comment="Streets" Bounds="60,170,461,61" ShowValueBox="true" isIOBox="true" Value="MULTILINESTRING ((-4 -2, -2 -2), (-4 0, -2 0), (-4 2, -2 2), (-4 -2, -4 0), (-4 0, -4 2), (-2 -2, -2 0), (-2 0, -2 2), (-2 0, 0 0), (0 -2, 2 -2), (2 -2, 4 -2), (0 0, 2 0), (2 0, 4 0), (0 2, 1 2.6, 2 2), (2 2, 4 2), (0 -2, 0 0), (0 0, 0 2), (2 -2, 2 0), (4 -2, 4 0), (4 0, 4 2), (2 2, 3 3.2), (-4 -2, -5 -3), (6 -2, 7 -1))">
