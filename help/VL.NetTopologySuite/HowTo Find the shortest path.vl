          <Pad Id="HCOQ8mqtc0DGV2jQ2xGjgU" Bounds="60,40,465,41" ShowValueBox="true" isIOBox="true" Value="Use Network and ShortestPath!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
