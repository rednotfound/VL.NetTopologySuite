              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="SmHzF2DVsfU17be9rHHzIe" Bounds="579,295,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; One line per street. Streets connect only where they share an endpoint with IDENTICAL coordinates. (-2 0, 0 0) is the bridge, the only line between the banks.">
