      <Patch Id="Dyl43NaN65RHvhJFO9C0vG">
        <Canvas Id="SdPu5WTsqh0oIrEx07tfZn" CanvasType="Group">
          <Pad Id="GgCoj5OOiBr6wrkDAIZcXl" Bounds="60,60,900,190" ShowValueBox="true" isIOBox="true" Value="One idea: close does not mean reachable. Two points can be a step apart across a river and a long walk apart by the streets.&#xD;&#xA;&#xD;&#xA;Network takes LineStrings that share endpoints EXACTLY and builds an undirected graph: every distinct endpoint is a node, every LineString an edge, its length the cost. ShortestPath snaps From and To to the nearest network node and runs Dijkstra. Found can be False - when the destination sits on a piece of network that shares no endpoint with the rest, the honest answer is &quot;no path&quot;, and it is an answer, not an error. Networks Built stays at 1 while you move From and To: the graph is built once, the question is asked every frame.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
