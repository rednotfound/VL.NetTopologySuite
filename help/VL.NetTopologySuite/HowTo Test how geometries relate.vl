          </Pad>
          <Pad Id="TicYZ3sDGAYNYP5fFbFtCf" Bounds="60,95,480,82" ShowValueBox="true" isIOBox="true" Value="The yes/no questions about two geometries - cheaper than the overlays, and usually what you actually wanted. A is a big square, B a small one inside it. A Point against a Polygon is the everyday &quot;is it inside&quot; question.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="GSupJWhtTZWiLPIHQIpZJU" Comment="A" Bounds="60,170,253,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))">
