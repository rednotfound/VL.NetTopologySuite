          <Pad Id="B93CCtaBAeROup0YrYV61O" Bounds="60,40,570,41" ShowValueBox="true" isIOBox="true" Value="Use Intersects, Contains and Within!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="JCUrOaoPFJGV1PuifbNIIE" Bounds="60,95,480,82" ShowValueBox="true" isIOBox="true" Value="The yes/no questions about two geometries - cheaper than the overlays, and usually what you actually wanted. A is a big square, B a small one inside it. A Point against a Polygon is the everyday &quot;is it inside&quot; question.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="NDsHq4jIjzSQYmR2Mye16z" Comment="A" Bounds="60,170,400,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 4 0, 4 4, 0 4, 0 0))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="IPiXjukrA2AW6ZJCB0LoiS" Comment="B" Bounds="60,210,400,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((1 1, 2 1, 2 2, 1 2, 1 1))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="RdePmvHVvTaNvKLmpPGo3K" Bounds="580,190,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Edit B until it pokes out of A: Contains and Within fall to False while Intersects holds. Move it out of A entirely and Intersects falls too.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
