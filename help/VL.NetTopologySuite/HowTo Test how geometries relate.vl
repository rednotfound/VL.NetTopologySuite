              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="Ic535A2pIjbpdJF4Au9dkl" Comment="B" Bounds="232,220,241,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((1 1, 2 1, 2 2, 1 2, 1 1))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
