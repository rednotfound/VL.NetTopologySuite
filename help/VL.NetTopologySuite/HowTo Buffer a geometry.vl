          <Pad Id="N7BdbY291McWpjJL35f6Zx" Comment="Intersection area" Bounds="230,530,80,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="PMSY8fduflfdfh9j7sZdfu" Bounds="580,490,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Intersection of the buffered shape with the original gives the original back - area 1 again. Geometry in, geometry out: operations chain with nothing in between.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
