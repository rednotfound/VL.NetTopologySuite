            <Pin Id="QIMcLpWKMSmy2sPylXlol9" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="Vee6hDcErDHs3QdrcDtvsb" Bounds="580,170,320,44" ShowValueBox="true" isIOBox="true" Value="&lt; Feed it a LINESTRING and see the corridor.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="400,220,50,19" Id="O2VqKMguuxqXpg8KyMK9pz">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Area" />
