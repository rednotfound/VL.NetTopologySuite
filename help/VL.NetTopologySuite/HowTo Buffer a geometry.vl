          <Pad Id="DCSW42bxhmqP3Fe8A8z3j1" Bounds="580,490,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Intersection of the buffered shape with the original gives the original back - area 1 again. Geometry in, geometry out: operations chain with nothing in between.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
