            </p:NodeReference>
            <Pin Id="RyG0yNvqjx8FyrPe1281DQ" Name="Geometry" Kind="InputPin" />
            <Pin Id="Lfboc7ZhPRjNtERJVYeOmb" Name="Distance" Kind="InputPin" />
            <Pin Id="PnSg59eT6QvkFk7AuoZqSO" Name="Segments" Kind="InputPin" />
            <Pin Id="Bya6zeluKyTApCz7DFeQHy" Name="Output" Kind="OutputPin" />
          </Node>
          <Pad Id="KKqzVGiVTxOWXdYfjfq8sX" Bounds="580,438,320,44" ShowValueBox="true" isIOBox="true" Value="&lt; Try a negative distance: the shape shrinks.">
            <p:TypeAnnotation>
