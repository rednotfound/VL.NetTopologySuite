    <Canvas Id="IJ9brKgCOrRCKLd0cdxBUy" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="NAeb62p8n9EAZTFeJ1HWcn">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="IU7GDr4coNY3XZja3hdj1K">
        <Canvas Id="P96gxp5u0X8Vr6L0J4eLFt" CanvasType="Group">
          <Pad Id="LJ50Lhei6uPPmnGOEb7MWR" Bounds="60,40,195,41" ShowValueBox="true" isIOBox="true" Value="Use Buffer!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Se9tMovb3wiQVhSq0VDqpc" Bounds="60,95,480,64" ShowValueBox="true" isIOBox="true" Value="Buffer grows a geometry outwards by a distance, and shrinks it with a negative one. Whatever goes in, a polygon comes out: a point becomes a disc, a line a corridor.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="IfOPu8fHuPdS9kl4j7yqpk" Comment="Shape" Bounds="60,170,400,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,220,90,19" Id="L0ppwj7DlR4nLeepcMrYN2">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="KfBfV7RpJyPUg1Eg7mhgk8" Name="WKT" Kind="InputPin" />
            <Pin Id="SQDeUzvPqXI1QZ7PRUw3dC" Name="Factory" Kind="InputPin" />
            <Pin Id="K2JxGHEQnYKGTrM5zjqgW0" Name="Result" Kind="OutputPin" />
            <Pin Id="MN85TWqQtS9Gdu7bOoupz4" Name="Success" Kind="OutputPin" />
          </Node>
          <Pad Id="KggHPuJx4c5PgZqeOLZcmw" Bounds="580,170,320,44" ShowValueBox="true" isIOBox="true" Value="&lt; Feed it a LINESTRING and see the corridor.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="400,220,50,19" Id="LvneUJwpltlNPAZvIhqis5">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Area" />
            </p:NodeReference>
            <Pin Id="CTYzKffeGpmkXnMSnaqKr0" Name="Geometry" Kind="InputPin" />
            <Pin Id="MB1foXqot1EYbz0zQdO797" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="A1A2O3jHpVTJy5Ql7EG1et" Comment="Area before" Bounds="400,260,80,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="ST48CKgPrjSW3mMz97X6in" Comment="Distance" Bounds="230,280,80,15" ShowValueBox="true" isIOBox="true" Value="0.25">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="BVakaQ10K7lWQaK7ue37Dj" Bounds="580,280,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; THE DISTANCE IS IN THE GEOMETRY'S OWN UNITS. Here 0.25 is a quarter of the unit square. On longitude/latitude it would be a quarter DEGREE - project to metres first.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="LBos5U5UAgli2xGzu3ItWg" Comment="Segments" Bounds="230,320,80,15" ShowValueBox="true" isIOBox="true" Value="8">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Integer32" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="NeAIOWQPnRccsMh4XHV69V" Bounds="580,368,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Segments per quarter turn. 8 is NetTopologySuite's default and visibly faceted; raise it and watch &quot;Area after&quot; converge.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,370,70,19" Id="ETDdKMI86U68fdFdu2uBrK">
