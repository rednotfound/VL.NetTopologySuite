          <Pad Id="CIlV2wWKU2i9y7K6B1dIbL" Bounds="60,95,480,82" ShowValueBox="true" isIOBox="true" Value="A Feature is a geometry with a Dictionary of attributes. It is NetTopologySuite's own type - the one VL.GeoJSON reads and VL.Mapsui draws, so all three packages share it without referencing each other.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
