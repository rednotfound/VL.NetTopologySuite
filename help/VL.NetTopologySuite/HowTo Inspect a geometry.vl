          </Node>
          <Pad Id="F8I91QciLlOJLMEWCxnm4J" Comment="empty?" Bounds="330,410,60,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="600,370,50,19" Id="KY71nH6sq2ODzw5eRf39ZO">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
