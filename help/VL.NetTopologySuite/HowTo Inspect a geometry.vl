  <Patch Id="GWmICawyPAy0uoXlerSi9M">
    <Canvas Id="V47srUCpZsmygPKzX3tGdj" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="O0GIveP1LKtNgjsO6xv8IZ">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="JLbCwVVVB5RShNwpQrcnPM">
        <Canvas Id="CCQx84u1K0S59inp0s6Hl2" CanvasType="Group">
          <Pad Id="UmXy35N7pC65by9YlUcnOY" Bounds="60,60,900,150" ShowValueBox="true" isIOBox="true" Value="One idea: every geometry answers the same questions, whatever its type.&#xD;&#xA;&#xD;&#xA;Read WKT gives a Geometry, and the readers in NTS.Geometry take any Geometry: a Point, a LineString, a Polygon with holes, a whole collection. Paste a different WKT into the box and every readout below follows. The numbers are in the coordinates' own units - plain numbers here; on longitude and latitude they would be degrees and square degrees.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="EdqWbeKEO3Yx04ZZ2OjDfw" Comment="a 4 x 3 rectangle with a unit hole - edit me" Bounds="60,250,620,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 4 0, 4 3, 0 3, 0 0), (1 1, 2 1, 2 2, 1 2, 1 1))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,300,90,19" Id="UD6BHGeV6vihNlAKHJjv4h">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="DCL8KEGCS0n6bEuC4xR0JT" Name="WKT" Kind="InputPin" />
            <Pin Id="JVb3wGyFB1tAhVkvjVrkTM" Name="Factory" Kind="InputPin" />
            <Pin Id="GRlnXYzCmOmcXBn3MY3vUG" Name="Result" Kind="OutputPin" />
            <Pin Id="AultXezs1LpKmz7eIAvOoa" Name="Success" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,370,110,19" Id="EkaQhTMQIpFiDA0tUp5qHr">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="GeometryType" />
            </p:NodeReference>
            <Pin Id="Rwm7R2BcxZs62IDgKgSmUE" Name="Geometry" Kind="InputPin" />
            <Pin Id="D61ZFoNnLOLmTg9up47pTs" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="IeOuuWWlLuIe68Q8mj52b8" Comment="type" Bounds="60,410,160,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="330,370,70,19" Id="C6hd8kF0BxKFve75a1zdwW">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
