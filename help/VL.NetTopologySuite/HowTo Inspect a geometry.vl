          </Node>
          <Pad Id="D2ZzX63Pe0NvuOx6nVWJcV" Comment="area (12 minus the hole)" Bounds="60,510,100,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="330,470,60,19" Id="JfSTUjuMdXutHvhkKtSxPQ">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Length" />
            </p:NodeReference>
            <Pin Id="BI3TcVjaWC48xpXxchZPmE" Name="Geometry" Kind="InputPin" />
            <Pin Id="GBzDpnlIlXXGZaSnomTJV5" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="HUZVzqSC6kCRAlj4dnNL94" Comment="length (both rings)" Bounds="330,510,100,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="600,470,70,19" Id="GcMQJ2LdJevKue8TVVgCch">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Centroid" />
            </p:NodeReference>
            <Pin Id="BaayHpGOdMAUnLAxWpn192" Name="Geometry" Kind="InputPin" />
            <Pin Id="M8OtZdD3Ju9tt3OGqKlocz" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="600,520,90,19" Id="QpKx7d87sK6B43gcFkvtTP">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="JL0XDLYRqMrHpgaSasEnxr" Name="Geometry" Kind="InputPin" />
            <Pin Id="KMxPLrRxFAfNBKZYwEAEAO" Name="Include Z" Kind="InputPin" />
            <Pin Id="HB3qgIXVOLsVLUEAufJset" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="UGoH4Dj4XcTHFJcutSFNJ3" Comment="centroid" Bounds="600,560,300,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,610,60,19" Id="DCVFERQ2Pjr4lzJm92VlHe">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Bounds" />
            </p:NodeReference>
            <Pin Id="MgzTK842IpRI4q6xtuVazV" Name="Geometry" Kind="InputPin" />
            <Pin Id="S8sFG2a1AA1mWeFWOWU57u" Name="Min X" Kind="OutputPin" />
            <Pin Id="Kaqs6KCDbzGSNHO8uifT54" Name="Min Y" Kind="OutputPin" />
            <Pin Id="GMSpjK1xRlo1TiNcagKxaN" Name="Max X" Kind="OutputPin" />
            <Pin Id="GyXjdvo8TOb48cGvv2iSm7" Name="Max Y" Kind="OutputPin" />
          </Node>
          <Pad Id="G84IlDWc339jLhMcGl3FoG" Comment="min X" Bounds="60,650,80,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="JDlGVlK6yPlmYxaewl7Npz" Comment="min Y" Bounds="200,650,80,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="D29fQZB9vhNrLJoe4O7wgi" Comment="max X" Bounds="340,650,80,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="SrwPwo2R15c26Yw35MG3RE" Comment="max Y" Bounds="480,650,80,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="VNJC3AQLFa4J19aj44WFjb" Bounds="60,710,900,130" ShowValueBox="true" isIOBox="true" Value="Bounds is the axis-aligned box around the geometry: the cheapest question there is, and the one spatial indexes are built on - see HowTo Query many geometries fast. Length is the perimeter for a polygon, both rings counted, and the run of the line for a LineString. The centroid is pulled slightly right of the rectangle's middle by the hole.&#xD;&#xA;&#xD;&#xA;IsValid is the one reader not shown here; HowTo Create a polygon has it. Coordinates and Geometries hand the parts back as Spreads, for vvvv's own nodes to work on.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
        <Patch Id="M4pLhx7URPeQZWwLG5rWK3" Name="Create" />
