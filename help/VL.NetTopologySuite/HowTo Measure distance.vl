    <Canvas Id="MtuniUZqflWT9qQH4fGSo5" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="Swxt3g3stfTXBsGdU8Y6z7">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
