            </p:TypeAnnotation>
          </Pad>
          <Pad Id="UMrf4Nx5BUcbBZ9ddYBq90" Bounds="580,210,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Move B inside the square: Distance drops to 0. Move it level with a side: the nearest point on A slides along that side - a point on the boundary, not a vertex.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
