      </p:NodeReference>
      <Patch Id="UkM1iYBoefDnr4wuahvRPq">
        <Canvas Id="LLd3ntKJjbSHhmg6bG1Gfl" CanvasType="Group">
          <Pad Id="SWaMDhWzyd3PR2RM0GFdNU" Bounds="60,40,510,41" ShowValueBox="true" isIOBox="true" Value="Use Distance and Nearest Points!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="FQKxNthz98NWqoN0GEFCho" Bounds="60,95,480,46" ShowValueBox="true" isIOBox="true" Value="The shortest gap between two geometries, and where it is. A is a unit square, B a point some way off.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="G4ovuVYICxeMFJSpsSC5FF" Comment="A" Bounds="60,170,400,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="Jih4MkmXYDeMSQi8oyq9Z1" Comment="B" Bounds="60,210,400,15" ShowValueBox="true" isIOBox="true" Value="POINT (3 2)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="L4wJu5b5HodJT1W8TlYJg6" Bounds="580,210,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Move B inside the square: Distance drops to 0. Move it level with a side: the nearest point on A slides along that side - a point on the boundary, not a vertex.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,260,90,19" Id="UxbITJmzVAmXdCMD1KsTMS">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
