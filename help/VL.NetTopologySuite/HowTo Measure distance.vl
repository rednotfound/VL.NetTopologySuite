          <Pad Id="EYTyMcGmKhd2Q43yFLZJzJ" Bounds="580,330,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Between the closest parts, not the centres: 0 for anything that touches. sqrt 5 here, in the coordinates' own units - degrees on lon/lat, so project first.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
