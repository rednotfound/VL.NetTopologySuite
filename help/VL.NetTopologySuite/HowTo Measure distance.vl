          </Pad>
          <Pad Id="ADKnLB014VAS3tX5L054q8" Comment="A" Bounds="60,170,400,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="T51sxGSv2srlvXK4RBA0W3" Comment="B" Bounds="60,210,400,15" ShowValueBox="true" isIOBox="true" Value="POINT (3 2)">
