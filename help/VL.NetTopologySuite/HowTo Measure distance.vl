  <Patch Id="VHb71CxduRFi57AcTeB4cE">
    <Canvas Id="SoaEuYS6EzDBrxELC9ijeV" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="DM0GLWzch8tRo1RYEiuOsr">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="Uqb2OSE42AmJIM4NEFjTfW">
        <Canvas Id="Njbt6NbIARYqXBPQmHwrHR" CanvasType="Group">
          <Pad Id="RCBRsMtAcE3x87rKjVl7CH" Bounds="60,60,900,150" ShowValueBox="true" isIOBox="true" Value="One idea: Distance is the shortest gap between two geometries, and Nearest Points tells you where that gap is.&#xD;&#xA;&#xD;&#xA;A is a unit square and B is a point some way off. Distance is measured between the closest parts, not the centres, so it is 0 for anything that touches or overlaps. Nearest Points gives the two coordinates that realise it, one on each geometry; turned into Points and written as WKT, they are the two ends of the line you would draw.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="NpyxEow0bscR59ijLyzWqe" Comment="A" Bounds="60,250,460,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="TftOyCk1dfcv0ay1MOkUVD" Comment="B - move it" Bounds="60,290,460,15" ShowValueBox="true" isIOBox="true" Value="POINT (3 2)">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,340,90,19" Id="RDFIRKBLgwtEsKaioIBVAJ">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="FDUeCutaUSgjo225H8AFEF" Name="WKT" Kind="InputPin" />
            <Pin Id="ILTaXBfTKfpJAcWsw20eZA" Name="Factory" Kind="InputPin" />
            <Pin Id="NO02Xpy7r0foKxeVqm071C" Name="Result" Kind="OutputPin" />
            <Pin Id="IVdh4R1P66LPXBrEOV9yl4" Name="Success" Kind="OutputPin" />
          </Node>
          <Node Bounds="330,340,90,19" Id="EyJT7Mo9FjHBKXBKEw9O4l">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="U0WF5h3lh2KabVUn5msLjO" Name="WKT" Kind="InputPin" />
            <Pin Id="RkQtzCfD1fyYjrKzvDHNE3" Name="Factory" Kind="InputPin" />
            <Pin Id="Li7uHI5VsQknZ5uzsmTK8J" Name="Result" Kind="OutputPin" />
            <Pin Id="Qa1wt2Zr1ZDXl5CcdN5dIx" Name="Success" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,420,70,19" Id="AQ3vQiiTtMIOVBW7MMeoc2">
            <p:NodeReference LastCategoryFullName="NTS.Operation" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Distance" />
            </p:NodeReference>
            <Pin Id="KQRuccftkFCvHKS0YRXQNX" Name="A" Kind="InputPin" />
            <Pin Id="ATVC2gzjxO3srdMvJ5Lkyi" Name="B" Kind="InputPin" />
            <Pin Id="K8QDsy7oyCRvv6Ixe89lrj" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="MRD4qNhtFktkFJ850EbZ5n" Comment="distance (sqrt 5, about 2.24)" Bounds="60,460,100,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="330,420,100,19" Id="C9be8gh6vxCU9CWVv1tGvO">
            <p:NodeReference LastCategoryFullName="NTS.Operation" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Nearest Points" />
            </p:NodeReference>
            <Pin Id="PCnGKLKekq9Zg1NBtyuwSK" Name="A" Kind="InputPin" />
            <Pin Id="HN8m8zf9zZfDmH0nZ3SFTU" Name="B" Kind="InputPin" />
            <Pin Id="GCL2snigdyyaJymbFy3Wum" Name="On A" Kind="OutputPin" />
            <Pin Id="VcVGqsAIFSX55KIdCVtBMU" Name="On B" Kind="OutputPin" />
          </Node>
          <Node Bounds="330,480,60,19" Id="Qa6Kro7weWl6w1pdILJDi2">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Point" />
            </p:NodeReference>
            <Pin Id="VFd3q06f5Ui4X05h20BVsa" Name="Coordinate" Kind="InputPin" />
            <Pin Id="UShrthe25iCb5paobQOSad" Name="Factory" Kind="InputPin" />
            <Pin Id="EXftbAYxTLoHd6UmLI2dM9" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="330,530,90,19" Id="VdfJLXPadEQsWTZM1ozNNT">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="VIVdJ4PkXrbc69svorg1w1" Name="Geometry" Kind="InputPin" />
            <Pin Id="LwgJJh4YxntedbQP7HRUPT" Name="Include Z" Kind="InputPin" />
            <Pin Id="RgoPAcr5zDNKWIPfP0Qzul" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="ElHhD0vyuWSxgyroMdvL7x" Comment="nearest on A" Bounds="330,570,150,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="600,480,60,19" Id="VOeul7YUG2iDoSSaz7x1Pc">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Point" />
            </p:NodeReference>
            <Pin Id="JbS2L2r568lsrHXVdCYAeA" Name="Coordinate" Kind="InputPin" />
            <Pin Id="APVrUwv5dLGJZjjrNbF4aA" Name="Factory" Kind="InputPin" />
            <Pin Id="MdhgUkA81UCeH93uzNcyut" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="600,530,90,19" Id="ErdxmBpKr3zzV97sa0OBeK">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="JXyNeLgxoWYOaVru4D3fum" Name="Geometry" Kind="InputPin" />
            <Pin Id="FATfKhFMOHOL4liTntrCKE" Name="Include Z" Kind="InputPin" />
            <Pin Id="EQDLRXVuxfUrrWlHBth4sc" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="HgFfhcsnoBkvSQpvdNqMAw" Comment="nearest on B" Bounds="600,570,150,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="IkUE5IZyxXiDqlzjVu8ICC" Bounds="60,630,900,130" ShowValueBox="true" isIOBox="true" Value="The distance is in the coordinates' own units, like everything else in this package. On longitude and latitude it comes out in degrees, which is not a distance anyone wants - project to a metric reference system first.&#xD;&#xA;&#xD;&#xA;Move B inside the square and Distance drops to 0 while the nearest point on A becomes B itself. Move it level with a side and the nearest point on A slides along that side: it is a point on the boundary, not a vertex. Buffer(A, Distance(A, B)) is a shape that just reaches B - a neat check that the two nodes agree.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
