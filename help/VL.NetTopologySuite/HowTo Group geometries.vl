          <Pad Id="S7V94QcZnfrbQczF74J7kW" Comment="as WKT" Bounds="60,640,900,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,690,80,19" Id="Q86fMAE3tGYcObyt7JHCxf">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Geometries" />
            </p:NodeReference>
            <Pin Id="SSsOq6JQQp8xlwcymkwFS6" Name="Geometry" Kind="InputPin" />
            <Pin Id="KfZyYt4WDrN1U2fx7aBOrZ" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="CjCiLIZ5VCQzuOPYvaXopb" Comment="the parts, as a Spread of Geometry" Bounds="60,730,300,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="R4YpPDKSuCc5BzQo0KADRn" Bounds="60,780,900,200" ShowValueBox="true" isIOBox="true" Value="MultiPoint, MultiLineString and MultiPolygon are the strict containers: each takes only its own type. A Spread of Point from Cons goes straight into MultiPoint, while a Geometry from Read WKT does not, because Read WKT cannot promise what it read - if you need a MultiPolygon from text, write the MULTIPOLYGON in the WKT itself.&#xD;&#xA;&#xD;&#xA;Prefer the strict container when you can. Some operations refuse a GeometryCollection, and an overlay on one is a known NetTopologySuite limitation. Geometries on a single Point or Polygon hands back that one geometry, so it is safe to call on anything.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
