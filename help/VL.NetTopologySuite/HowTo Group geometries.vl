      <Patch Id="PHYRfN9SV5zoH3iseLlNYS">
        <Canvas Id="BHD7fC9npWKOPUgDc2mtER" CanvasType="Group">
          <Pad Id="EvgZEqzhBAhxAgoQZPMCHv" Bounds="60,60,900,150" ShowValueBox="true" isIOBox="true" Value="One idea: several geometries can travel as one, and the container decides how much is promised about what is inside.&#xD;&#xA;&#xD;&#xA;A GeometryCollection promises nothing: here a point, a line and a polygon, read from WKT and gathered by Cons, go in together. The collection is a Geometry itself, so GeometryType names it, Area and Length sum whatever parts have any, and Write WKT writes the lot. Geometries takes it apart again into a Spread for vvvv's own nodes.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
