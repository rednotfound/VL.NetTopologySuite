      <Patch Id="Afy1MBzLfmToT0hZyaJgAm">
        <Canvas Id="BPueJa42Gkugs6SH6u4Cp9" CanvasType="Group">
          <Pad Id="Sw1rJnGrFQ8UIp4PyQ6A7H" Bounds="60,40,450,41" ShowValueBox="true" isIOBox="true" Value="Draw it with GeometryEditor!">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="PizQsFkkcU0mLrckMZFmUI" Bounds="60,95,480,46" ShowValueBox="true" isIOBox="true" Value="Select the node and press Ctrl+Shift+W. A window opens: draw in it, and the patch follows.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,180,110,19" Id="Fcm41JLNVWJYvIY7MRVj3N">
