          <Pad Id="ALg5dN8BMgRUZg9d70I7gl" Bounds="580,220,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Click a shape, then drag its points or the +. Drag a box to select several shapes, or several points.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
