            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="NiyCfpDnihnItSPNb41Kvj" Bounds="580,290,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Rectangle and Circle are drags. Two polygons make a MULTIPOLYGON; add a line and it is a GEOMETRYCOLLECTION.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
