    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="EsagAxfVQCsS6ODOpWhWgf">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
