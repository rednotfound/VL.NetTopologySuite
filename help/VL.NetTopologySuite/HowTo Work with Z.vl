  <NugetDependency Id="T7TPcqx9ClWdu1OscktZ7x" Location="VL.CoreLib" Version="2025.7.4" />
  <Patch Id="TpyK6in8toypUu0bOykFgK">
    <Canvas Id="JyOkGZl48DMsFNBVQPPADP" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="FJh4rbXnVtuN7cfuEJHJWF">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="Q8WW6aWMweGXRL2tVyeaPa">
        <Canvas Id="F8aACvpc2Ktrw14iGD7FiA" CanvasType="Group">
          <Pad Id="K6JO9Vpa83Y1NBfGixSQYt" Bounds="60,60,900,150" ShowValueBox="true" isIOBox="true" Value="One idea: a coordinate can carry a third number, and whether it survives depends on who you hand it to.&#xD;&#xA;&#xD;&#xA;CoordinateZ takes X, Y and Z, and Point keeps all three. Write WKT drops Z unless Include Z is on - the two boxes below are the same Point written both ways. Split takes any Coordinate apart again; on a plain XY Coordinate its Z comes back as NaN, which is how NetTopologySuite says &quot;never set&quot;.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="UFHYjYaHaqh4QkNKEXMHEh" Comment="X (longitude)" Bounds="60,250,100,15" ShowValueBox="true" isIOBox="true" Value="139.7671">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="ET5xfe6ddKblUbUb84mnku" Comment="Y (latitude)" Bounds="60,290,100,15" ShowValueBox="true" isIOBox="true" Value="35.6812">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="C9gXQdWFyAkGVuk7V8UJv0" Comment="Z (height, in whatever unit you mean)" Bounds="60,330,100,15" ShowValueBox="true" isIOBox="true" Value="40">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,380,90,19" Id="CcjR2xd0wdRYHvtYUEvkcM">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="CoordinateZ" />
            </p:NodeReference>
            <Pin Id="HxSvymhe96aPBJPkjjyDaA" Name="X" Kind="InputPin" />
            <Pin Id="RpqRK074CfYf6vVitMANLJ" Name="Y" Kind="InputPin" />
            <Pin Id="Hsy82B6Ahb8vxFOlOVAQ4P" Name="Z" Kind="InputPin" />
            <Pin Id="J8PMURRw9l9JtZ8kQ3unx2" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,440,60,19" Id="Slc8wxc0QxN0VZS5wvxkkh">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Point" />
            </p:NodeReference>
            <Pin Id="OIR13ZXZjglEiJjrCp42AF" Name="Coordinate" Kind="InputPin" />
            <Pin Id="IJyA07WtzLJO5EK6jPgOvt" Name="Factory" Kind="InputPin" />
            <Pin Id="EthAcq9qpcis7yjI8rjRUK" Name="Result" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,500,90,19" Id="P36eP1DOixcP2heEaMdVJg">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="JAs9yH8ZidwdXNp1mp738e" Name="Geometry" Kind="InputPin" />
            <Pin Id="TjNClXA3apJwrQsu01w2aF" Name="Include Z" Kind="InputPin" />
            <Pin Id="F4TQG96yDnx3uyBV2BoCpA" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="MCqaHjRGRY2FTl9kEBBsSG" Comment="Include Z off - Z is silently gone" Bounds="60,540,300,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="FvUl5ART9TzXIQhAxv5KQR" Comment="Include Z" Bounds="620,460,60,15" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="620,500,90,19" Id="VaqHz6HVtyjgNI4Qbg4QPE">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="S0ygul7EiPN8OstX7BkBdy" Name="Geometry" Kind="InputPin" />
            <Pin Id="OhVn3PzmJANjx0ndYL91ne" Name="Include Z" Kind="InputPin" />
            <Pin Id="QvaKNkdRSbejFwkIR9Pe0R" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="BtZcv7CZm4OpvtyRLfV9oJ" Comment="Include Z on" Bounds="620,540,300,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,610,50,19" Id="TQheetGNxL0A2wecHW1npj">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Split" />
            </p:NodeReference>
            <Pin Id="Vy1ETGG4Avvny1j3AaRKIk" Name="Coordinate" Kind="InputPin" />
            <Pin Id="ANewboC1gxcCC1GWpXPqwB" Name="X" Kind="OutputPin" />
            <Pin Id="USUaHP5qoAyLhvwl3WMySN" Name="Y" Kind="OutputPin" />
            <Pin Id="OSdeCil1iN9c43hZVxDGrq" Name="Z" Kind="OutputPin" />
          </Node>
          <Pad Id="QEGSeWbimrndnzJPdGgQHP" Comment="X" Bounds="60,650,100,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="QYPuLZX6N0sv8ZrDRyDNuK" Comment="Y" Bounds="200,650,100,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="JA3WUu4T4lvd4Ecmnp5huZ" Comment="Z" Bounds="340,650,100,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="VUBEJXZAWWUEjlFqoQpO55" Bounds="60,710,900,130" ShowValueBox="true" isIOBox="true" Value="Read WKT understands the Z form too: paste POINT Z (139.7671 35.6812 40) into HowTo Read and write WKT and Split its first coordinate. Whether an operation such as Buffer keeps Z is NetTopologySuite's decision, not this package's - when it matters, check with Write WKT and Include Z on.&#xD;&#xA;&#xD;&#xA;Z is a number with no unit and no meaning of its own. Nothing here knows whether 40 is metres above sea level, floors, or the third axis of a model. M, the fourth ordinate, is not exposed yet.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
