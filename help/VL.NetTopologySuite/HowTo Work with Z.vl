        <Canvas Id="Ph1su8l60mb4XVLxWLMIBp" CanvasType="Group">
          <Pad Id="CTY0YxG6I98hbvnesDkbIA" Bounds="60,40,270,41" ShowValueBox="true" isIOBox="true" Value="Use CoordinateZ!">
