          <Node Bounds="60,550,90,19" Id="OddWpBrw0rWDOLiIgCHXDr">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="DHH2deUVnkcDfnrujBC5Ik" Name="Geometry" Kind="InputPin" />
            <Pin Id="Qhpxo2r7WBKWg57P0AeiDR" Name="Include Z" Kind="InputPin" />
            <Pin Id="Rc5hL8ewMGU3gCJf4ase2Y" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="LckxU5Kj64K8RYwvGmaIIn" Comment="WKT" Bounds="60,590,300,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="KZyJVY9MAHsKjfD3x7h6ot" Bounds="580,550,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Include Z on: POINT Z (...). Read WKT understands this form too. Whether Buffer and friends keep Z is NetTopologySuite's decision - check here when it matters.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
