            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="ALOZFic1gAYX1k2lEusE2v" Comment="Include Z" Bounds="60,510,60,15" ShowValueBox="true" isIOBox="true" Value="True">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Boolean" />
