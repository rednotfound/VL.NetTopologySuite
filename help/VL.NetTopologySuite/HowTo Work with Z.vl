            </p:TypeAnnotation>
          </Pad>
          <Pad Id="NmmXtcoLOhqMYuzPgnSC9Q" Comment="Z" Bounds="60,250,100,15" ShowValueBox="true" isIOBox="true" Value="40">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
