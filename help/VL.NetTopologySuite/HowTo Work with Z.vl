          <Pad Id="M8HxNzlvAaYla7z0YKKj9t" Bounds="580,650,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Split takes any Coordinate apart. On a plain XY Coordinate, Z comes back as NaN - NetTopologySuite's way of saying &quot;never set&quot;.">
            <p:TypeAnnotation>
