          </Pad>
          <Pad Id="U0T6Oc49yGkzA3EeJ5vaAE" Bounds="580,250,320,80" ShowValueBox="true" isIOBox="true" Value="&lt; Z has no unit and no meaning of its own - metres, floors or a model axis, nothing here knows. M, the fourth ordinate, is not exposed.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,300,90,19" Id="Q9gtpAw22scKEwgClAzoOF">
