            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="USY13QQe6o8ZKpO3jIUVDh" Bounds="60,95,480,46" ShowValueBox="true" isIOBox="true" Value="A coordinate can carry a third number. Who keeps it and who drops it is the whole story.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="JztbIwWBqAmcP1cw9CpQpY" Comment="X" Bounds="60,170,100,15" ShowValueBox="true" isIOBox="true" Value="139.7671">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Float64" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="CLWsPiqgMtOicwBWNGPM0z" Comment="Y" Bounds="60,210,100,15" ShowValueBox="true" isIOBox="true" Value="35.6812">
