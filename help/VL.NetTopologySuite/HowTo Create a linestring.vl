      <Patch Id="P9V5YWGmDarIYn1l9xdRvS">
        <Canvas Id="UOZMY5Pa1PyD0el2W9RAjU" CanvasType="Group">
          <Pad Id="Pwq7fzut2Wp9jpXESm1eW8" Bounds="60,60,900,150" ShowValueBox="true" isIOBox="true" Value="One idea: a LineString is an ordered run of coordinates, and the order is the shape.&#xD;&#xA;&#xD;&#xA;Three coordinates go in through Cons, which builds a Spread from separate values, and LineString joins them in that order. Swap two of them and the line folds back on itself - same points, different shape. Length is measured along the line, in the coordinates' own units: here 2 x sqrt(2), about 2.83.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="GNyRtyP3GF0ViRy7reKyKW" Comment="point 1 X" Bounds="60,250,100,15" ShowValueBox="true" isIOBox="true" Value="0">
