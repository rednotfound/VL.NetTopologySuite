    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="MsCI83FYV5BMLw2egVB8LS">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
