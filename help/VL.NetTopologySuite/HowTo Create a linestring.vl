          <Pad Id="KAkbgzWesMZZL5JmZrZEFS" Comment="as WKT" Bounds="420,575,460,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="M9MWLEi5GMcjG43MkgMmqN" Bounds="60,640,900,130" ShowValueBox="true" isIOBox="true" Value="Two coordinates are the minimum; there is no upper limit, and a run of a million coordinates is one LineString. A line that ends where it started is still a LineString - it only becomes a ring when you build a LinearRing from the same coordinates, which is what HowTo Create a polygon does.&#xD;&#xA;&#xD;&#xA;Factory is left unconnected, so the SRID is 0, &quot;unset&quot;. Connect a GeometryFactory node to say 4326.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
