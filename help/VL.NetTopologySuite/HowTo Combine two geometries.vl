  <Patch Id="V0wbNGezih3NCEovsXnxFR">
    <Canvas Id="VSEt3ERRzpwzqdTeiP3EkD" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <!--

    ************************ Application ************************

-->
    <Node Name="Application" Bounds="100,100" Id="EGyF5MIQgVvSrIxJBzAMEI">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="Ljvljz5AwRXdGNhGdvPHIn">
        <Canvas Id="ETDfu6opnAFzpXQQ4ORL0d" CanvasType="Group">
          <Pad Id="KcsklFkFvqogMKyR9PVBck" Bounds="60,60,900,150" ShowValueBox="true" isIOBox="true" Value="One idea: two geometries combine into one in three ways, and each answer is a geometry you can keep working with.&#xD;&#xA;&#xD;&#xA;A and B are two unit squares that overlap by a quarter. Union is everything covered by either; Intersection is only what both cover; Difference is A with B cut away. Every result is a Geometry again, so Area reads it and Write WKT shows it - and any of them can feed the next operation without a conversion in between.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Nm3Ev9RoRwcNkfqeQ6Uk8p" Comment="A - edit me" Bounds="60,250,460,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="JtqWO1BHUGwdvbrni85E5z" Comment="B - edit me" Bounds="60,290,460,15" ShowValueBox="true" isIOBox="true" Value="POLYGON ((0.5 0.5, 1.5 0.5, 1.5 1.5, 0.5 1.5, 0.5 0.5))">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,340,90,19" Id="BSVuPjcJdQu8ba9TTCLzAb">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="Ikod63YecRpy0gNBmi03iM" Name="WKT" Kind="InputPin" />
            <Pin Id="A9WtRe3NedMDaQUfCHhF7f" Name="Factory" Kind="InputPin" />
            <Pin Id="MZvFlhUGvnNXnGzFf7O62v" Name="Result" Kind="OutputPin" />
            <Pin Id="C76bTibgpIPcwSMDu5nuev" Name="Success" Kind="OutputPin" />
          </Node>
          <Node Bounds="330,340,90,19" Id="Cgj7vatZxCXYLHyX6b7PPw">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Read WKT" />
            </p:NodeReference>
            <Pin Id="SnnS3zhW1XmE0zPFZgjJiD" Name="WKT" Kind="InputPin" />
            <Pin Id="Dp2Tcqe6KouXugfOGExhqy" Name="Factory" Kind="InputPin" />
            <Pin Id="ALcosoCAsvuJPWT7pbVXlM" Name="Result" Kind="OutputPin" />
            <Pin Id="Cnbo1CRVvcnfKW9xto6X9F" Name="Success" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,430,60,19" Id="Aj1x826GtYxnrfL3M7LDkS">
            <p:NodeReference LastCategoryFullName="NTS.Operation" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Union" />
            </p:NodeReference>
            <Pin Id="BQmP40Dmjfyd2b5OrC46qO" Name="A" Kind="InputPin" />
            <Pin Id="LvRRkXXrBpJKHSpyTyGZI2" Name="B" Kind="InputPin" />
            <Pin Id="Aowd1kn3m3Ud4nBE4uH3a9" Name="Output" Kind="OutputPin" />
          </Node>
          <Node Bounds="60,490,50,19" Id="BeQzLuAMLXIsoYCQAJlawW">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Area" />
            </p:NodeReference>
            <Pin Id="Mc5kuP6Q8eO5nJHwKSxGtr" Name="Geometry" Kind="InputPin" />
            <Pin Id="MEBtms6kTAQHLdtzOVwPhK" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="FUdsZ1zPB8gaeuDjFYerpt" Comment="union area" Bounds="60,530,100,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="330,430,100,19" Id="PSEOP9KLkv165FHsGFCGAB">
            <p:NodeReference LastCategoryFullName="NTS.Operation" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Intersection" />
            </p:NodeReference>
            <Pin Id="PorH3JnNqHWY1InSGXtnbP" Name="A" Kind="InputPin" />
            <Pin Id="SNGpnDQoDvznDE1oWsLOhh" Name="B" Kind="InputPin" />
            <Pin Id="QzNfodxRv6HkO5vtZPIbQM" Name="Output" Kind="OutputPin" />
          </Node>
          <Node Bounds="330,490,50,19" Id="VRfFDk7b6aVkdc8HMgzvJ8">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Area" />
            </p:NodeReference>
            <Pin Id="FFLaeWKfWgBMytGJlSOaz5" Name="Geometry" Kind="InputPin" />
            <Pin Id="HgjSpXAzaD2wK4eRSpjpqI" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="DbCFCY3asImJ4HvPVufBvN" Comment="intersection area" Bounds="330,530,100,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="600,430,90,19" Id="N2MiGyX1xtWCZrIu8UiyvF">
            <p:NodeReference LastCategoryFullName="NTS.Operation" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Difference" />
            </p:NodeReference>
            <Pin Id="SicKRHZdFGGFEB8sRM3YuW" Name="A" Kind="InputPin" />
            <Pin Id="AwhrMjSXwLRwSFuWlBPJ4C" Name="B" Kind="InputPin" />
            <Pin Id="QPuWu1OKBhIz3elhi8Q1td" Name="Output" Kind="OutputPin" />
          </Node>
          <Node Bounds="600,490,50,19" Id="FlJHb1qk51VL5KQ52nSS1M">
            <p:NodeReference LastCategoryFullName="NTS.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Area" />
            </p:NodeReference>
            <Pin Id="Ck42oi2wmsHoCIOLk4SYXJ" Name="Geometry" Kind="InputPin" />
            <Pin Id="BuLrOs1KMTI1lpuqFRFILF" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="D1K6M44cQrcxZ7EtPNAXzd" Comment="difference area" Bounds="600,530,100,15" ShowValueBox="true" isIOBox="true" />
          <Node Bounds="60,600,90,19" Id="G3LyH7teGkUkb0VgeGxL4x">
            <p:NodeReference LastCategoryFullName="NTS.IO" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Write WKT" />
            </p:NodeReference>
            <Pin Id="ChCP7XqTdZMX8QelMMiq6p" Name="Geometry" Kind="InputPin" />
            <Pin Id="OX2c8GWg1wEbfI8DRtCdNa" Name="Include Z" Kind="InputPin" />
            <Pin Id="M6PSNGDYJkMKiW1TL4oBho" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="M77mSRs5xHDwCK1iBqgrWm" Comment="the union as WKT - one polygon with eight corners" Bounds="60,640,900,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="SCfHMxD03UrZfAHiloUgZz" Bounds="60,700,900,130" ShowValueBox="true" isIOBox="true" Value="The areas add up: 1 + 1 - 0.25 = 1.75, 0.25, 0.75. That arithmetic is the quickest check that an overlay did what you meant, and it is why each result has its own Area here.&#xD;&#xA;&#xD;&#xA;The fourth overlay, SymmetricDifference, is not a node: it is Union minus Intersection, two nodes you already have. The overlays take any geometry types - a line against a polygon, a point against a line - and the result type follows from what is left, so Intersection of two touching squares is a LineString and of two corner-touching squares a Point.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">11</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
        <Patch Id="OnGeIG3TWsCHKwN4KmaYzj" Name="Create" />
        <Patch Id="Tmkzc2AyapQn7F29mUnz9x" Name="Update" />
        <ProcessDefinition Id="J87NliOSvbPGCyZtMVTGIv">
          <Fragment Id="VcXnebncnGj0VcdWlfqFgZ" Patch="OnGeIG3TWsCHKwN4KmaYzj" Enabled="true" />
