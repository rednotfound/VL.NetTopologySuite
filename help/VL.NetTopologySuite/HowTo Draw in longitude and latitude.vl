<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:p="property" xmlns:r="reflection" Id="LFFwTTFt5shwTvMjg1IkrT" LanguageVersion="2025.7.4" Version="0.128">
  <NugetDependency Id="IC7QEyjs9aOUSdy2FkuF8y" Location="VL.CoreLib" Version="2025.7.4" />
  <Patch Id="EUPUVVwG1S1oqkvRbUl0gf">
    <Canvas Id="RIYGZTiBAf3DD8aAiI8Tby" DefaultCategory="Main" BordersChecked="false" CanvasType="FullCategory" />
    <Node Name="Application" Bounds="100,100" Id="TVjkUD3MAxuJgVaTuzTEgJ">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
        <CategoryReference Kind="Category" Name="Primitive" />
      </p:NodeReference>
      <Patch Id="N3DfodTOONkRFe5lsgb8V8">
        <Canvas Id="AAIwyjLYht3k9FmxaDUkk6" CanvasType="Group">
          <Pad Id="CYMd1Yu4nFGEZ1qJvPwnOk" Bounds="60,40,520,41" ShowValueBox="true" isIOBox="true" Value="Draw it in longitude and latitude!">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">20</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="AAa7IC0UE0dPw1h53193ls" Bounds="60,95,520,46" ShowValueBox="true" isIOBox="true" Value="Give GeometryEditor an SRID. 4326 says the numbers are degrees of longitude and latitude.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="O5UbLIDc1H48eEv8ZfSTcK" Comment="SRID" Bounds="150,165,45,15" ShowValueBox="true" isIOBox="true" Value="4326">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="Integer32" />
            </p:TypeAnnotation>
          </Pad>
          <Node Bounds="60,200,110,19" Id="OyiPZyi7nhOKJSwnIcBuIt">
            <p:NodeReference LastCategoryFullName="NetTopologySuite.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="GeometryEditor" />
              <PinReference Kind="InputPin" Name="WKT" />
            </p:NodeReference>
            <p:HelpFocus p:Assembly="VL.Lang" p:Type="VL.Model.HelpPriority">Low</p:HelpFocus>
            <Pin Id="AcT0rdyV8gcKSrUgygrcQl" Name="WKT" Kind="InputPin" DefaultValue="POLYGON ((4.355 52.008, 4.365 52.008, 4.365 52.01416, 4.355 52.01416, 4.355 52.008))">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="String" />
              </p:TypeAnnotation>
            </Pin>
            <Pin Id="EoE8vJrZzo3Hvlp8zsKmAO" Name="SRID" Kind="InputPin" />
            <Pin Id="SjxfCxRqIJwNBRXfihbzla" Name="Result" Kind="OutputPin" />
            <Pin Id="SiNrDOzKBc3KthX8mgeaCQ" Name="Is Editable" Kind="OutputPin" />
          </Node>
          <Pad Id="AOCEepgN2CcMi7QwwmmMPi" Bounds="340,165,320,44" ShowValueBox="true" isIOBox="true" Value="&lt; 4326 is WGS 84, what GPS and web maps give. 28992 would be metres in the Netherlands.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="PrNfMExy7E7MsOSuIyyzJz" Bounds="340,215,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; Select me, then Ctrl+Shift+W. The status bar says lon, lat and degrees, and this block looks square.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="Jz6P9O3jjo26B1qctNA3HH" Comment="" Bounds="60,240,240,170" ShowValueBox="true" isIOBox="true" />
          <Pad Id="BgbRswjOIWxXo0SWfyeQA2" Bounds="340,300,320,62" ShowValueBox="true" isIOBox="true" Value="&lt; A degree east is shorter than a degree north here, so this box and the window both narrow it: the block is square.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,480,45,19" Id="LPgR73EHf15uJC4BPY74CH">
            <p:NodeReference LastCategoryFullName="NetTopologySuite.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="SRID" />
            </p:NodeReference>
            <p:HelpFocus p:Assembly="VL.Lang" p:Type="VL.Model.HelpPriority">Low</p:HelpFocus>
            <Pin Id="U5QPxMNm4cUe96f0fEQkON" Name="Geometry" Kind="InputPin" />
            <Pin Id="Fq7yR7bI6T76WvkbbEd9mg" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="CGlDAeyioEwC2G9Lk3ciSz" Comment="" Bounds="60,515,45,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="SRDwuPGGlBRwQ69EHyh29R" Bounds="180,477,300,44" ShowValueBox="true" isIOBox="true" Value="&lt; The geometry carries its SRID to every node downstream.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
          <Node Bounds="60,570,45,19" Id="P2t8LzvpuZyjsC52Tskx67">
            <p:NodeReference LastCategoryFullName="NetTopologySuite.Geometry" LastDependency="VL.NetTopologySuite.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Area" />
            </p:NodeReference>
            <p:HelpFocus p:Assembly="VL.Lang" p:Type="VL.Model.HelpPriority">Low</p:HelpFocus>
            <Pin Id="UTrztUB1A0yUnfySsYiPcY" Name="Geometry" Kind="InputPin" />
            <Pin Id="Ca2uoMHbNEfCK3ABo5teIL" Name="Result" Kind="OutputPin" />
          </Node>
          <Pad Id="O8ukpXEm9zhCzEdsosdvdL" Comment="" Bounds="60,605,90,15" ShowValueBox="true" isIOBox="true">
            <p:ValueBoxSettings>
              <p:precision p:Type="Int32">8</p:precision>
            </p:ValueBoxSettings>
          </Pad>
          <Pad Id="HYDsEUgS7zYQijrJB5azUX" Bounds="180,567,300,44" ShowValueBox="true" isIOBox="true" Value="&lt; Square degrees, not square metres. Reproject (VL.PROJ) to 28992 first to measure.">
            <p:TypeAnnotation>
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
        </Canvas>
        <Patch Id="RgwJteYEclVrXL2JSBtSQB" Name="Create" />
        <Patch Id="FDyc4eOyEOLgj6sSe6F3ex" Name="Update" />
