    <Canvas Id="JOqFNmakFr2kcBOdvvtNCG" DefaultCategory="NetTopologySuite.HDE" CanvasType="FullCategory">
      <!--

    ************************ RegisterServices ************************

    The editor calls this when the document is loaded (a <Package>.HDE.vl beside the package
    document is picked up without the user referencing it - CoreLib's 'HowTo Patch a Tooltip').
    Two viewers: one for every Geometry (lines, polygons, collections drawn as outlines) and a
    more specific one for a lone Point, which has no outline to draw and gets a dot instead.
    Shape copied from VL.Audio.HDE.vl and VL.Stride.HDE.vl.

-->
      <Node Name="RegisterServices" Bounds="60,60,240,300" Id="NMLo6UTnzj7auvLN0KFbPv">
        <p:NodeReference LastCategoryFullName="Primitive" LastDependency="builtin">
          <Choice Kind="OperationDefinition" Name="Operation" />
        </p:NodeReference>
        <Patch Id="OQab4MzEYNQpCHqMgqi80d">
          <Node Bounds="120,110,110,84" Id="SA0qo8X7S50EcwP5F7xVL3">
            <p:NodeReference LastCategoryFullName="HDE.Viewers" LastDependency="VL.HDE.vl">
