      <!--

    ************************ RegisterServices ************************

    The editor calls this when the document is loaded (a <Package>.HDE.vl beside the package
    document is picked up without the user referencing it - CoreLib's 'HowTo Patch a Tooltip').
    Three viewers: GeometryViewer for every Geometry, PointViewer for a lone Point, FeatureViewer
    for a Feature (its geometry drawn, every attribute listed with typed cells). A viewer for a bare
    Dictionary<String, Object> was tried and taken out the same day: it worked, but the editor's
    own grid draws typed cells and this package should not replace it machine-wide.
    Shape copied from VL.Audio.HDE.vl and VL.Stride.HDE.vl.

-->
      <Node Name="RegisterServices" Bounds="60,60,240,420" Id="BxZEUr3hPfCGxeP66oWpHH">
        <p:NodeReference LastCategoryFullName="Primitive" LastDependency="builtin">
          <Choice Kind="OperationDefinition" Name="Operation" />
