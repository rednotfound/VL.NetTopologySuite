      <!--

    ************************ GeometryViewer ************************

    GIS style, the way Leaflet and QGIS draw: Outlines sorts the geometry into rings, lines and
    points. Every ring is folded into ONE path (the ForEach accumulator: Top border point fed back
    to the Bottom one with IsFeedback, as VL.Skia's 'HowTo Compose PathEffects' does), filled
    even-odd so holes are cut out, and stroked. Lines are stroked. Points in a collection become
    circle markers whose radius is 2% of the bounds' larger side. Y is negated everywhere:
    geometry is y-up, Skia y-down. Colours are Leaflet's defaults. The editor's own LayerViewer
    fits the result into the widget.
-->
      <Node Name="GeometryViewer" Bounds="400,60" Id="MphlcuJ0i1zUupODY2rMV8">
        <p:NodeReference LastCategoryFullName="Primitive" LastDependency="builtin">
          <Choice Kind="ClassDefinition" Name="Class" />
        </p:NodeReference>
        <p:Interfaces>
          <TypeReference LastCategoryFullName="HDE.Viewers" LastDependency="VL.HDE.vl">
            <Choice Kind="MutableInterfaceType" Name="IValueViewer" />
            <p:TypeArguments>
              <TypeReference LastCategoryFullName="NetTopologySuite.Geometries" LastDependency="NetTopologySuite.dll">
                <Choice Kind="TypeFlag" Name="Geometry" />
              </TypeReference>
            </p:TypeArguments>
