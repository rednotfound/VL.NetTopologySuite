        <p:NodeReference LastCategoryFullName="Primitive" LastDependency="builtin">
          <Choice Kind="ClassDefinition" Name="Class" />
        </p:NodeReference>
        <p:Interfaces>
          <TypeReference LastCategoryFullName="HDE.Viewers" LastDependency="VL.HDE.vl">
            <Choice Kind="MutableInterfaceType" Name="IValueViewer" />
            <p:TypeArguments>
              <TypeReference LastCategoryFullName="NetTopologySuite.Geometries" LastDependency="NetTopologySuite.dll">
                <Choice Kind="TypeFlag" Name="Point" />
              </TypeReference>
