      <!--

    ************************ GeometryViewer ************************

    Value (any NTS Geometry) -> Outlines (every ring and line as its own coordinates, holes included)
    -> for each outline: for each coordinate: Vector2 with Y negated (geometry is y-up, Skia is
    y-down; without the flip a rising line drew as falling - seen in the second probe) -> AddPoly
    (Close False: rings repeat their first coordinate anyway) -> DrawPath with a hairline stroke
    -> Group -> the editor's own LayerViewer, which fits the layer's bounds into the widget.
    Points inside a collection (MultiPoint) have no outline and draw nothing yet.
-->
      <Node Name="GeometryViewer" Bounds="400,60" Id="Hgh2n4fwf4c0qSe3otgsoP">
        <p:NodeReference LastCategoryFullName="Primitive" LastDependency="builtin">
          <Choice Kind="ClassDefinition" Name="Class" />
